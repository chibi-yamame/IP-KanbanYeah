<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <RootNamespace>KanbanDrawer</RootNamespace>
    <AssemblyName>KanbanYeah</AssemblyName>
    <Version>0.2.0</Version>
    <Product>看板屋</Product>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <!-- 公式と同じ text: the program's renderer, run with the Java that opens .jar files (Java/KanbanText.java, tools/textjar.sh) -->
  <ItemGroup>
    <EmbeddedResource Include="Resources/kanban-text.jar" LogicalName="KanbanDrawer.kanban-text.jar" />
  </ItemGroup>

  <!-- the window / taskbar icon (the same file is the exe's icon); app.ico is rendered from the vector source app.svg -->
  <ItemGroup>
    <EmbeddedResource Include="app.ico" LogicalName="KanbanDrawer.app.ico" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="KanbanDrawer.Tests" />
  </ItemGroup>

</Project>
